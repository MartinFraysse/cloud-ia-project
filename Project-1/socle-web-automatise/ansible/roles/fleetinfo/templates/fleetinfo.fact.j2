{#
  Fait local Ansible (/etc/ansible/facts.d/fleetinfo.fact), relu à chaque collecte des facts
  sous ansible_local.fleetinfo : release active, release précédente (cible de rollback.yml) et
  date du dernier déploiement (affichée sur la page sans casser l'idempotence).
#}
{
  "_ansible_managed": {{ ansible_managed | to_json(ensure_ascii=False) }},
  "_source": "roles/fleetinfo/templates/fleetinfo.fact.j2",
  "version": {{ fleetinfo_version | to_json }},
  "previous_version": {{ fleetinfo_recorded_previous | to_json }},
  "release_dir": {{ fleetinfo_release_dir | to_json }},
  "deployed_at": {{ fleetinfo_deployed_at | to_json }}
}
